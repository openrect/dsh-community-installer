{
  "name": "dsh-community-installer",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "scripts": {
    "frontend:dev": "vite --host 127.0.0.1 --port 1420",
    "frontend:build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build:online": "node scripts/build.mjs online",
    "build:offline": "node scripts/build.mjs offline",
    "test": "vitest run && node scripts/verify-installer-entry.mjs && node scripts/verify-release-version.mjs && node scripts/cargo.mjs test --manifest-path src-tauri/Cargo.toml",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.2.0",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
